<Page
    x:Class="DbConnectHub.App.Pages.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="Privacy &amp; data" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16"
                       Text="What DB Connect Hub keeps, where it keeps it, and how to check that nothing leaves your PC." />

            <Grid CornerRadius="12" Padding="32" Background="{StaticResource HeroBrush}" ColumnSpacing="24" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xEA18;" FontSize="44" Foreground="{StaticResource OnHeroBrush}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Your data never leaves this PC" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource OnHeroBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource OnHeroSecondaryBrush}"
                               Text="DB Connect Hub has no server, no account, no telemetry and no update check. It only reads files on this PC and writes to your own Windows account." />
                </StackPanel>
            </Grid>

            <TextBlock Text="Where your data is" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
            <toolkit:SettingsCard Header="Connection details and settings"
                                  Description="{x:Bind ViewModel.DataFolderPath}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Open data folder" />
                    </StackPanel>
                </Button>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Passwords"
                                  Description="Windows Credential Manager, entries named DbConnectHub:&lt;id&gt;. Encrypted by Windows for your account only, and never written to a file.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="A damaged data file is never overwritten"
                                  Description="If a data file can't be read, a copy is saved next to it, you're told, and nothing is saved until you fix it.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C8;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock Text="Check it yourself" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <toolkit:SettingsCard Header="No networking code"
                                  Description="The code that scans, stores and shows your data uses no networking library. An automated test fails the build if it ever does.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </toolkit:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="See the test"
                                 NavigateUri="https://github.com/shahzaibali0/DataBaseCredsHandler/blob/main/tests/DbConnectHub.Tests/PrivacyTests.cs" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Open source"
                                  Description="Every line is public under the MIT license. Search it for HttpClient or Socket.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </toolkit:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="View on GitHub" NavigateUri="https://github.com/shahzaibali0/DataBaseCredsHandler" />
            </toolkit:SettingsCard>

            <TextBlock Text="Start over" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <toolkit:SettingsCard Header="Remove everything DB Connect Hub saved"
                                  Description="Close the app, delete the data folder above, then remove the DbConnectHub: entries in Credential Manager → Windows Credentials.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
