<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DbConnectHub.App</RootNamespace>
    <AssemblyName>DbConnectHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- WinUI 3, run unpackaged (no MSIX, no Store), with the Windows App SDK runtime copied next to the exe,
         the same way Proton VPN ships its Windows app. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Build tooling only (it generates resources.pri), needed for a single-file publish; the app stays unpackaged. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <!-- Only the .NET 10 runtime is installed on the dev machine; let the net8 app roll forward onto it. -->
    <RollForward>Major</RollForward>

    <!-- Program.cs has its own Main, so pgAdmin's password command is answered before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="WinUIEx" Version="2.9.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.0.124" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbConnectHub.Core\DbConnectHub.Core.csproj" />
    <ProjectReference Include="..\DbConnectHub.Scanner\DbConnectHub.Scanner.csproj" />
    <ProjectReference Include="..\DbConnectHub.Storage\DbConnectHub.Storage.csproj" />
    <ProjectReference Include="..\DbConnectHub.Integrations\DbConnectHub.Integrations.csproj" />
    <ProjectReference Include="..\DbConnectHub.Presentation\DbConnectHub.Presentation.csproj" />
  </ItemGroup>

</Project>
