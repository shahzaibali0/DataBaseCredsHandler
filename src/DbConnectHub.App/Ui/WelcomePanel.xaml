<UserControl
    x:Class="DbConnectHub.App.Ui.WelcomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- First run: the hero with the one big button, then what the app promises. -->
    <StackPanel Spacing="20">
        <Grid CornerRadius="12" Padding="48,44" Background="{StaticResource HeroBrush}">
            <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">
                <Border Style="{StaticResource PillStyle}" Background="{StaticResource HeroPillBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="PRIVATE  ·  OFFLINE  ·  OPEN SOURCE" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="60" Foreground="{StaticResource OnHeroBrush}" />
                </Border>
                <TextBlock Text="Every project's apps, local servers and databases" FontSize="36" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource OnHeroBrush}" />
                <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource OnHeroSecondaryBrush}"
                           Text="One click looks through your projects and lists each backend and frontend with its local address and databases, all kept on this PC." />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="22,12" FontSize="15"
                            Command="{x:Bind ViewModel.ScanCommand, Mode=OneWay}" AutomationProperties.Name="Scan my PC for databases">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE721;" FontSize="16" />
                            <TextBlock Text="Scan my PC" />
                        </StackPanel>
                    </Button>
                    <Button Padding="18,12" Command="{x:Bind ViewModel.ChooseFolderCommand, Mode=OneWay}" AutomationProperties.Name="Choose a folder instead">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                            <TextBlock Text="Choose a folder instead" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ScanScope, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource OnHeroSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xEA18;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Stays on this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Nothing is uploaded or sent to any server. No account, no telemetry." />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Passwords stay encrypted" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Database passwords stay in Windows Credential Manager at rest and appear in the database file when you open it." />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xEDA2;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Only your projects" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Skips Windows, Program Files, AppData, node_modules, .git, USB and network drives." />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
