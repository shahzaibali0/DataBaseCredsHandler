<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Screen state and commands, with no UI framework: the WinUI app binds to these,
         and the tests drive them without a window. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DbConnectHub.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbConnectHub.Core\DbConnectHub.Core.csproj" />
    <ProjectReference Include="..\DbConnectHub.Scanner\DbConnectHub.Scanner.csproj" />
  </ItemGroup>

</Project>
