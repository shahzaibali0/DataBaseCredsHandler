<Page
    x:Class="PgCredsHandler.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16"
                       Text="Choose where PgCreds Handler looks for your projects." />

            <TextBlock Text="Where to scan" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
            <toolkit:SettingsCard Header="Folders to scan" Description="{x:Bind ViewModel.ScanScope, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Use all local drives" Command="{x:Bind ViewModel.UseAllDrivesCommand}"
                            Visibility="{x:Bind ViewModel.HasChosenFolders, Mode=OneWay}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Add folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ChosenFolders}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <toolkit:SettingsCard Header="{x:Bind}" Margin="32,0,0,0">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button Tag="{x:Bind}" Click="OnRemoveFolderClick" ToolTipService.ToolTip="Stop scanning this folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Remove" />
                                </StackPanel>
                            </Button>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <toolkit:SettingsCard Header="Always skipped"
                                  Description="Windows, Program Files, ProgramData, AppData, node_modules, .git, bin, obj, venv, hidden folders, USB and network drives.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE711;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock Text="Background" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <toolkit:SettingsCard Header="Start with Windows"
                                  Description="Starts quietly in the notification area when you sign in, and rescans your projects so the list is always up to date.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Keep running when the window is closed"
                                  Description="Closing the window hides it to the notification area; open it again from the tray icon. Right-click the icon and choose Exit to quit.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE737;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.KeepRunningInTray, Mode=TwoWay}" AutomationProperties.Name="Keep running in the tray" />
            </toolkit:SettingsCard>

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <toolkit:SettingsCard Header="Theme" Description="Follows your Windows light or dark mode (Settings → Personalization → Colors).">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <toolkit:SettingsCard Header="PgCreds Handler" Description="Free and open source under the MIT license.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="Source code and issues" NavigateUri="https://github.com/shahzaibali0/DataBaseCredsHandler" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
