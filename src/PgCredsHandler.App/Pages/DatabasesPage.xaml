<Page
    x:Class="PgCredsHandler.App.Pages.DatabasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:pres="using:PgCredsHandler.Presentation"
    xmlns:ui="using:PgCredsHandler.App.Ui"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Something needs your attention" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- ============ First run ============ -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay}">
                <Grid CornerRadius="12" Padding="48,44" Background="{StaticResource HeroBrush}">
                    <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">
                        <Border Style="{StaticResource PillStyle}" Background="{StaticResource HeroPillBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="PRIVATE  ·  OFFLINE  ·  OPEN SOURCE" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60" Foreground="{StaticResource OnHeroBrush}" />
                        </Border>
                        <TextBlock Text="Find every Postgres database on this PC" FontSize="36" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource OnHeroBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource OnHeroSecondaryBrush}"
                                   Text="One click looks through your projects' .env, docker-compose and appsettings.json files and collects every database connection into one safe list." />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="22,12" FontSize="15"
                                    Command="{x:Bind ViewModel.ScanCommand}" AutomationProperties.Name="Scan my PC for databases">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                                    <TextBlock Text="Scan my PC for databases" />
                                </StackPanel>
                            </Button>
                            <Button Padding="18,12" Command="{x:Bind ViewModel.ChooseFolderCommand}" AutomationProperties.Name="Choose a folder instead">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                    <TextBlock Text="Choose a folder instead" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ScanScope, Mode=OneWay}" FontSize="13"
                                   Foreground="{StaticResource OnHeroSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Stays on this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Nothing is uploaded or sent to any server. No account, no telemetry." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Passwords stay encrypted" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Kept in Windows Credential Manager, protected by your Windows account. Never in a file." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Only your projects" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Skips Windows, Program Files, AppData, node_modules, .git, USB and network drives." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ============ Scanning ============ -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="44" Height="44" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Scanning your projects…" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ui:Badges.FormatCount(ViewModel.FilesChecked), Mode=OneWay}" /><Run Text=" config files checked" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ui:Badges.FormatCount(ViewModel.DatabasesFound), Mode=OneWay}" /><Run Text=" databases found" FontWeight="Normal" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ScanCancelCommand}" AutomationProperties.Name="Cancel scan">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Saved databases ============ -->
            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.HasConnections, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Databases" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ChooseFolderCommand}"
                            ToolTipService.ToolTip="Scan one folder you pick" AutomationProperties.Name="Choose folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="Choose folder" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ScanCommand}" ToolTipService.ToolTip="Scan again (F5)" AutomationProperties.Name="Rescan">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Projects" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.ProjectCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Databases" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.DatabaseCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="On remote servers" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.RemoteCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" QueryIcon="Find"
                                    PlaceholderText="Search by project, host, database or user  (Ctrl+F)"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                    <toolkit:Segmented Grid.Column="1" SelectedIndex="{x:Bind ViewModel.HostFilterIndex, Mode=TwoWay}">
                        <toolkit:SegmentedItem Content="All" />
                        <toolkit:SegmentedItem Content="On this PC" />
                        <toolkit:SegmentedItem Content="On a network" />
                    </toolkit:Segmented>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.ScanScope, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,-8,0,0" />

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center" Padding="0,12">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="No databases match your search" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Try another word, or switch the filter back to All." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="pres:ProjectGroupViewModel">
                            <toolkit:SettingsExpander Header="{x:Bind ProjectName}" Description="{x:Bind ProjectPath}"
                                                      IsExpanded="True" ItemsSource="{x:Bind Connections}">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </toolkit:SettingsExpander.HeaderIcon>
                                <TextBlock Text="{x:Bind CountLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <toolkit:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="pres:ConnectionRowViewModel">
                                        <toolkit:SettingsCard Header="{x:Bind Database}" Description="{x:Bind Description}"
                                                              ToolTipService.ToolTip="{x:Bind SourceFile}">
                                            <toolkit:SettingsCard.HeaderIcon>
                                                <FontIcon Glyph="&#xE8F1;" />
                                            </toolkit:SettingsCard.HeaderIcon>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsStale}">
                                                    <TextBlock Text="No longer found" FontSize="12" />
                                                </Border>
                                                <Border Style="{StaticResource TagStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="11" />
                                                        <TextBlock Text="{x:Bind PasswordLabel}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PillStyle}" Background="{x:Bind ui:Badges.HostBrush(HostKind)}" MinWidth="72">
                                                    <TextBlock Text="{x:Bind HostKindLabel}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" Foreground="{StaticResource OnBadgeBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </toolkit:SettingsCard>
                                    </DataTemplate>
                                </toolkit:SettingsExpander.ItemTemplate>
                            </toolkit:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchShortcut" />
    </Page.KeyboardAccelerators>
</Page>
