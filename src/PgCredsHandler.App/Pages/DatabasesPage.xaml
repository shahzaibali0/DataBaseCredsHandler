<Page
    x:Class="PgCredsHandler.App.Pages.DatabasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:PgCredsHandler.Presentation"
    xmlns:ui="using:PgCredsHandler.App.Ui"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchShortcut" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Page.KeyboardAccelerators>

    <Grid>
        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                         Title="Something needs your attention" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}" Severity="Success"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" CloseButtonCommand="{x:Bind ViewModel.DismissStatusCommand}" />

                <ui:WelcomePanel ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay}" />

                <!-- Scanning -->
                <Border Style="{StaticResource CardStyle}" Padding="24" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="44" Height="44" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Scanning your projects…" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="{x:Bind ui:Badges.FormatCount(ViewModel.FilesChecked), Mode=OneWay}" /><Run Text=" files checked   ·   " FontWeight="Normal" /><Run Text="{x:Bind ui:Badges.FormatCount(ViewModel.DatabasesFound), Mode=OneWay}" /><Run Text=" databases found" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" Style="{StaticResource FieldLabelStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ScanCancelCommand}" Content="Cancel" />
                    </Grid>
                </Border>

                <!-- Projects -->
                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Projects" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ChooseFolderCommand}"
                                ToolTipService.ToolTip="Scan one folder you pick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Choose folder" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ScanCommand}" ToolTipService.ToolTip="Scan again (F5)" AutomationProperties.Name="Rescan">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Rescan" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ui:StatCards ViewModel="{x:Bind ViewModel}" />

                    <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" MaxWidth="480" HorizontalAlignment="Left"
                                    PlaceholderText="Search projects, apps, databases or hosts  (Ctrl+F)"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}">
                        <StackPanel Spacing="4" HorizontalAlignment="Center" Padding="0,12">
                            <TextBlock Text="Nothing matches your search" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Try a project, app, database or host name." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Square project cards; click one to open everything about it. -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Workspaces}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="250" MinItemHeight="250" MinRowSpacing="16" MinColumnSpacing="16"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="pres:WorkspaceViewModel">
                                <Button Style="{StaticResource ProjectCardButtonStyle}" Click="OnProjectClick" Tag="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource HeroBrush}" />
                                        <StackPanel Grid.Row="1" Padding="18,16" Spacing="12">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource HeroBrush}">
                                                    <TextBlock Text="{x:Bind Initials}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource OnHeroBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="17"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind CountLabel}" Style="{StaticResource FieldLabelStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{x:Bind StackSummary}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" FontSize="13" />
                                            <ItemsRepeater ItemsSource="{x:Bind Servers}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="pres:AppGroupViewModel">
                                                        <Grid ToolTipService.ToolTip="{x:Bind ui:Badges.StatusText(RunState), Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                         Fill="{x:Bind ui:Badges.StatusBrush(RunState), Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind RoleLabel}" Style="{StaticResource FieldLabelStyle}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind PortLabel}" Style="{StaticResource FieldValueStyle}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                        <Border Grid.Row="2" Padding="18,8" BorderThickness="0,1,0,0"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource FieldLabelStyle}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The project window, over the grid. Click outside or press Esc to close. -->
        <Grid Visibility="{x:Bind ViewModel.IsProjectOpen, Mode=OneWay}">
            <Border Background="{StaticResource OverlayBackdropBrush}" Tapped="OnBackdropTapped" />
            <Border MaxWidth="1180" Margin="32,24" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer Padding="28,24">
                    <ui:ProjectDetailPanel Project="{x:Bind ViewModel.SelectedProject, Mode=OneWay}" ViewModel="{x:Bind ViewModel}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
