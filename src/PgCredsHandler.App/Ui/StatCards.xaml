<UserControl
    x:Class="PgCredsHandler.App.Ui.StatCards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:PgCredsHandler.App.Ui">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="2">
                <TextBlock Text="Projects" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.ProjectCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="2">
                <TextBlock Text="Apps" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.AppCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="2">
                <TextBlock Text="Databases" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ui:Badges.FormatCount(ViewModel.DatabaseCount), Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
