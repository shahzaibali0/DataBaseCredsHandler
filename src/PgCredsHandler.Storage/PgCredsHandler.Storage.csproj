<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows because the credential store uses the Windows Credential Manager API.
         A no-op store is provided for non-Windows so the solution still builds/tests on CI. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PgCredsHandler.Storage</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PgCredsHandler.Core\PgCredsHandler.Core.csproj" />
  </ItemGroup>

</Project>
